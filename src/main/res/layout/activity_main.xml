<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- 标题栏：应用名 + 关于 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/app_name"
                style="@style/Text.SFD.Headline" />

            <Button
                android:id="@+id/btn_about"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:minWidth="56dp"
                android:minHeight="36dp"
                android:text="@string/about"
                style="@style/Widget.SFD.Button.Outlined" />
        </LinearLayout>

        <TextView
            android:id="@+id/status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="未连接"
            android:textColor="@color/md_primary"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/stats"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="总请求 0 · 成功 0 · 失败 0"
            android:textColor="@color/md_on_surface_variant"
            android:textSize="12sp" />

        <!-- 快速连接卡片（记住的设备，程序控制显示） -->
        <LinearLayout
            android:id="@+id/quick_connect_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/card_bg_accent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="16dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/quick_connect"
                    android:textColor="@color/md_on_primary_container"
                    android:textSize="11sp"
                    android:letterSpacing="0.08"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/quick_device_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text=""
                    android:textColor="@color/md_on_primary_container"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/quick_device_mac"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                android:text=""
                android:textColor="@color/md_on_surface_variant"
                android:textSize="12sp" />
            </LinearLayout>

            <Button
                android:id="@+id/btn_quick_connect"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:minWidth="88dp"
                android:text="@string/connect"
                style="@style/Widget.SFD.Button.Filled" />
        </LinearLayout>

        <!-- 已配对设备：列出系统蓝牙中已配对的手表，点击直接连接 -->
        <Button
            android:id="@+id/btn_bonded"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/refresh_bonded"
            style="@style/Widget.SFD.Button.Outlined" />

        <Button
            android:id="@+id/btn_refresh_apps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:visibility="gone"
            android:text="@string/refresh_apps"
            style="@style/Widget.SFD.Button" />

        <Button
            android:id="@+id/btn_disconnect"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:visibility="gone"
            android:text="@string/disconnect"
            style="@style/Widget.SFD.Button.Outlined" />

        <!-- 设备信息（连接成功后显示；读取标准 GATT 服务，不影响桥接） -->
        <LinearLayout
            android:id="@+id/device_info_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/card_bg"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/section_device_info"
                android:textColor="@color/md_primary"
                android:textSize="13sp"
                android:letterSpacing="0.08"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="88dp"
                    android:layout_height="wrap_content"
                    android:text="@string/info_name"
                    android:textColor="@color/md_on_surface_variant"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/info_name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/info_unknown"
                    android:textColor="@color/md_on_surface"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="88dp"
                    android:layout_height="wrap_content"
                    android:text="@string/info_battery"
                    android:textColor="@color/md_on_surface_variant"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/info_battery"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/info_unknown"
                    android:textColor="@color/md_on_surface"
                    android:textSize="13sp" />
            </LinearLayout>

            <Button
                android:id="@+id/btn_refresh_device_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:visibility="gone"
                android:text="@string/refresh_device_info"
                style="@style/Widget.SFD.Button.Outlined" />
        </LinearLayout>

        <!-- 使用提示（未连接时显示，连接成功后隐藏） -->
        <LinearLayout
            android:id="@+id/tips_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/card_bg"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/section_tips"
                android:textColor="@color/md_primary"
                android:textSize="13sp"
                android:letterSpacing="0.08"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/tips_connect_state"
                android:textColor="@color/md_on_surface"
                android:textSize="13sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/section_faq"
                android:textColor="@color/md_on_surface_variant"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/tips_faq_1"
                android:textColor="@color/md_on_surface"
                android:textSize="13sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/tips_faq_2"
                android:textColor="@color/md_on_surface"
                android:textSize="13sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/tips_notify"
                android:textColor="@color/md_warning"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- 可用设备（连接成功后隐藏） -->
        <LinearLayout
            android:id="@+id/section_devices"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/section_bonded"
                style="@style/Text.SFD.Label" />

            <LinearLayout
                android:id="@+id/scan_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical" />
        </LinearLayout>

        <!-- 最近应用（最近 4 个成功桥接的应用） -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/section_recent"
            style="@style/Text.SFD.Label" />

        <LinearLayout
            android:id="@+id/recent_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical" />

        <!-- 应用列表 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/section_apps"
            style="@style/Text.SFD.Label" />

        <LinearLayout
            android:id="@+id/app_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical" />

        <!-- 日志 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/section_log"
            style="@style/Text.SFD.Label" />

        <ScrollView
            android:id="@+id/log_scroll"
            android:layout_width="match_parent"
            android:layout_height="280dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/log_bg"
            android:padding="12dp">

            <TextView
                android:id="@+id/log"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:textColor="@color/md_log_text"
                android:textSize="11sp" />
        </ScrollView>
    </LinearLayout>
</ScrollView>
