<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- MIUIX / HyperOS 设计语言主题（浅色为基准，跟随系统深浅） -->
    <style name="AppTheme.Base" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:colorPrimary">@color/md_primary</item>
        <item name="android:colorPrimaryDark">@color/md_surface_dim</item>
        <item name="android:colorAccent">@color/md_primary</item>
        <item name="android:windowBackground">@color/md_surface</item>
        <item name="android:statusBarColor">@color/md_surface</item>
        <item name="android:navigationBarColor">@color/md_surface</item>
        <item name="android:windowLightStatusBar">true</item>

        <!-- 控件默认色 -->
        <item name="android:textColorPrimary">@color/md_on_surface</item>
        <item name="android:textColorSecondary">@color/md_on_surface_variant</item>
        <item name="android:colorButtonNormal">@color/md_surface_container_high</item>

        <!-- 按钮形态 -->
        <item name="android:buttonStyle">@style/Widget.SFD.Button</item>
    </style>

    <style name="AppTheme" parent="AppTheme.Base" />

    <!-- 文本按钮（Tonal 基础） -->
    <style name="Widget.SFD.Button" parent="@android:style/Widget.Material.Button">
        <item name="android:textColor">@color/md_primary</item>
        <item name="android:background">@drawable/btn_tonal</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <!-- 突出按钮（Filled，蓝色实底） -->
    <style name="Widget.SFD.Button.Filled">
        <item name="android:background">@drawable/btn_filled</item>
        <item name="android:textColor">@color/md_on_primary</item>
    </style>

    <!-- 描边按钮（Outlined，蓝色描边） -->
    <style name="Widget.SFD.Button.Outlined">
        <item name="android:background">@drawable/btn_outlined</item>
        <item name="android:textColor">@color/md_primary</item>
    </style>

    <!-- 分区标题 -->
    <style name="Text.SFD.Label" parent="@android:style/Widget.Material.TextView">
        <item name="android:textColor">@color/md_on_surface_variant</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.08</item>
    </style>

    <!-- 应用主标题 -->
    <style name="Text.SFD.Headline" parent="@android:style/Widget.Material.TextView">
        <item name="android:textColor">@color/md_on_surface</item>
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
