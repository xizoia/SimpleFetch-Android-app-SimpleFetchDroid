<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- ============ 主内容（图1 首页） ============ -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- 标题栏：应用名 + 关于 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/app_name"
                    style="@style/Text.SFD.Headline" />

                <Button
                    android:id="@+id/btn_about"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:minWidth="56dp"
                    android:minHeight="36dp"
                    android:text="@string/about"
                    style="@style/Widget.SFD.Button.Outlined" />
            </LinearLayout>

            <!-- 连接异常红色提示（默认隐藏，检测到「应用列表为空且电量不可读」时显示） -->
            <TextView
                android:id="@+id/alert_banner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@color/md_error"
                android:textColor="@android:color/white"
                android:textSize="13sp"
                android:padding="12dp"
                android:gravity="center"
                android:text="@string/alert_conn_anomaly"
                android:visibility="gone" />

            <TextView
                android:id="@+id/status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="未连接"
                android:textColor="@color/md_primary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/stats"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="总请求 0 · 成功 0 · 失败 0"
                android:textColor="@color/md_on_surface_variant"
                android:textSize="12sp" />

            <!-- ============ 图1 Hero 连接卡片 ============ -->
            <LinearLayout
                android:id="@+id/hero_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/hero_card_bg"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- 顶部：图标方块 + 标题/副标题 + 状态药丸 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <FrameLayout
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:background="@drawable/hero_icon_tile">

                        <ImageView
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_link" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="14dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/hero_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/hero_title"
                            android:textColor="@color/md_on_primary_container"
                            android:textSize="20sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/hero_subtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/hero_subtitle"
                            android:textColor="@color/md_on_primary_container"
                            android:textSize="12sp"
                            android:alpha="0.85" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/hero_pill"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/hero_pill_bg"
                        android:text="@string/hero_status_off"
                        android:textColor="@color/md_on_surface_variant"
                        android:textSize="12sp"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:paddingTop="6dp"
                        android:paddingBottom="6dp" />
                </LinearLayout>

                <!-- 未连接时显示：MAC 输入 + 扫描/连接 -->
                <LinearLayout
                    android:id="@+id/hero_disconnected"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:orientation="vertical">

                    <EditText
                        android:id="@+id/hero_mac_edit"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/mac_field_outline"
                        android:hint="@string/hint_mac"
                        android:inputType="textCapCharacters"
                        android:maxLines="1"
                        android:textSize="13sp"
                        android:padding="12dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/hero_scan_btn"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/hero_scan"
                            style="@style/Widget.SFD.Button.Filled" />

                        <Button
                            android:id="@+id/hero_connect_btn"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="10dp"
                            android:text="@string/hero_connect"
                            style="@style/Widget.SFD.Button.Outlined" />
                    </LinearLayout>
                </LinearLayout>

                <!-- 或让我们继续：上次连接的设备，点击直接重连 -->
                <LinearLayout
                    android:id="@+id/hero_continue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/btn_outlined"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_link"
                        android:tint="@color/md_primary" />

                    <TextView
                        android:id="@+id/hero_continue_text"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="10dp"
                        android:textColor="@color/md_on_surface"
                        android:textSize="13sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="@string/hero_continue_go"
                        android:textColor="@color/md_primary"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- 已连接时显示：断开按钮 -->
                <Button
                    android:id="@+id/hero_disconnect_btn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:visibility="gone"
                    android:text="@string/disconnect"
                    style="@style/Widget.SFD.Button.Outlined" />

                <!-- 连接中显示：进度条（仅视觉）+ 取消 -->
                <LinearLayout
                    android:id="@+id/hero_connecting"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <ProgressBar
                        android:id="@+id/hero_progress"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:indeterminate="true"
                        android:indeterminateTint="@color/md_primary" />

                    <Button
                        android:id="@+id/hero_cancel_btn"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/cancel"
                        style="@style/Widget.SFD.Button.Outlined" />
                </LinearLayout>
            </LinearLayout>

            <Button
                android:id="@+id/btn_refresh_apps"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:visibility="gone"
                android:text="@string/refresh_apps"
                style="@style/Widget.SFD.Button" />

            <!-- 设备信息（连接成功后显示；读取标准 GATT 服务，不影响桥接） -->
            <LinearLayout
                android:id="@+id/device_info_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/card_bg"
                android:orientation="vertical"
                android:padding="16dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/section_device_info"
                    android:textColor="@color/md_primary"
                    android:textSize="13sp"
                    android:letterSpacing="0.08"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="88dp"
                        android:layout_height="wrap_content"
                        android:text="@string/info_name"
                        android:textColor="@color/md_on_surface_variant"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/info_name"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/info_unknown"
                        android:textColor="@color/md_on_surface"
                        android:textSize="13sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="88dp"
                        android:layout_height="wrap_content"
                        android:text="@string/info_battery"
                        android:textColor="@color/md_on_surface_variant"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/info_battery"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/info_unknown"
                        android:textColor="@color/md_on_surface"
                        android:textSize="13sp" />
                </LinearLayout>

                <Button
                    android:id="@+id/btn_refresh_device_info"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:visibility="gone"
                    android:text="@string/refresh_device_info"
                    style="@style/Widget.SFD.Button.Outlined" />
            </LinearLayout>

            <!-- 使用提示（未连接时显示，连接成功后隐藏） -->
            <LinearLayout
                android:id="@+id/tips_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/card_bg"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/section_tips"
                    android:textColor="@color/md_primary"
                    android:textSize="13sp"
                    android:letterSpacing="0.08"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/tips_connect_state"
                    android:textColor="@color/md_on_surface"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="@string/section_faq"
                    android:textColor="@color/md_on_surface_variant"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/tips_faq_1"
                    android:textColor="@color/md_on_surface"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/tips_faq_2"
                    android:textColor="@color/md_on_surface"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="@string/tips_notify"
                    android:textColor="@color/md_warning"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- 最近应用（最近 4 个成功桥接的应用） -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/section_recent"
                style="@style/Text.SFD.Label" />

            <LinearLayout
                android:id="@+id/recent_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical" />

            <!-- 应用列表 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/section_apps"
                style="@style/Text.SFD.Label" />

            <LinearLayout
                android:id="@+id/app_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical" />

            <!-- 日志 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/section_log"
                style="@style/Text.SFD.Label" />

            <ScrollView
                android:id="@+id/log_scroll"
                android:layout_width="match_parent"
                android:layout_height="280dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/log_bg"
                android:padding="12dp">

                <TextView
                    android:id="@+id/log"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:textColor="@color/md_log_text"
                    android:textSize="11sp" />
            </ScrollView>
        </LinearLayout>
    </ScrollView>

    <!-- ============ 图2 设备选择面板（全屏覆盖，默认隐藏） ============ -->
    <LinearLayout
        android:id="@+id/device_panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/md_surface"
        android:visibility="gone">

        <!-- 顶部栏：返回 + 标题（打开面板时全屏延伸到状态栏，头部加状态栏内边距避让） -->
        <LinearLayout
            android:id="@+id/panel_top_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="20dp"
            android:paddingTop="14dp"
            android:paddingBottom="14dp">

            <ImageButton
                android:id="@+id/panel_back_btn"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/btn_icon_ripple"
                android:src="@drawable/ic_arrow_back"
                android:contentDescription="@string/panel_title" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:text="@string/panel_title"
                style="@style/Text.SFD.Headline"
                android:textSize="20sp" />
        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- 上半：已配对设备（系统已配对 + 应用已保存 AuthKey 合并去重） -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/panel_paired"
                        style="@style/Text.SFD.Label" />

                    <LinearLayout
                        android:id="@+id/panel_add_btn"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:clickable="true"
                        android:focusable="true"
                        android:padding="6dp">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/ic_link"
                            android:tint="@color/md_primary" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:text="@string/panel_add"
                            android:textColor="@color/md_primary"
                            android:textSize="13sp" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/panel_paired_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="vertical" />

                <!-- 分割线 -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="20dp"
                    android:background="@color/md_outline" />

                <!-- 下半：扫描并添加（附近设备） -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/panel_nearby"
                        style="@style/Text.SFD.Label" />

                    <LinearLayout
                        android:id="@+id/panel_rescan_btn"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:clickable="true"
                        android:focusable="true"
                        android:padding="6dp">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/ic_refresh"
                            android:tint="@color/md_primary" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:text="@string/panel_rescan"
                            android:textColor="@color/md_primary"
                            android:textSize="13sp" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/panel_nearby_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="vertical" />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</FrameLayout>
